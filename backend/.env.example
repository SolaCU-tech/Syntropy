# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://syntropy:syntropy@localhost:5432/syntropy
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Object storage (MinIO locally). Used from Phase 4 for uploads.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=syntropy
S3_SECRET_KEY=syntropy-dev-secret
S3_BUCKET=syntropy-uploads
