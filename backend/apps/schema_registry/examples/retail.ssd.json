          "label": "Name",
          "type": "text",
          "required": true,
          "max_length": 120,
          "display_role": "title",
          "provenance": {"origin": "manual", "source_file": "ade_sales_2026.xlsx", "source_column": "Customer"}
        },
        {
          "id": "fld_customer_phone",
          "key": "phone",
          "label": "Phone",
          "type": "text",
          "unique": true,
          "max_length": 20
        },
        {
          "id": "fld_customer_area",
          "key": "area",
          "label": "Area",
