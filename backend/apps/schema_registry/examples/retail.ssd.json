        {
          "id": "fld_sale_payment_method",
          "key": "payment_method",
          "label": "Paid by",
          "type": "enum",
          "options": [
            {"key": "cash", "label": "Cash"},
            {"key": "transfer", "label": "Bank transfer"},
            {"key": "pos", "label": "POS"}
          ]
        },
        {
          "id": "fld_sale_notes",
          "key": "notes",
          "label": "Notes",
          "type": "text",
          "max_length": 500
        }
      ]
    }
