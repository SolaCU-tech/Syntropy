    {"id": "map_sales_price", "source_file": "ade_sales_2026.xlsx", "sheet": "Sales", "column": "Price", "table": "tbl_sales", "field": "fld_sale_unit_price", "transform": "parse_money"},
    {"id": "map_sales_amount", "source_file": "ade_sales_2026.xlsx", "sheet": "Sales", "column": "Amount", "table": "tbl_sales", "field": "fld_sale_total_amount", "transform": "parse_money"},
    {"id": "map_sales_paid", "source_file": "ade_sales_2026.xlsx", "sheet": "Sales", "column": "Paid", "table": "tbl_sales", "field": "fld_sale_amount_paid", "transform": "parse_money"},
    {"id": "map_customer_name", "source_file": "ade_sales_2026.xlsx", "sheet": "Sales", "column": "Customer", "table": "tbl_customers", "field": "fld_customer_name", "transform": "trim"},
    {"id": "map_product_name", "source_file": "ade_sales_2026.xlsx", "sheet": "Sales", "column": "Item", "table": "tbl_products", "field": "fld_product_name", "transform": "trim"}
