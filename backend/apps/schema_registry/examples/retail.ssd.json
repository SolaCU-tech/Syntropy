          "currency": "NGN",
          "min_value": "0",
          "display_role": "money"
        },
        {
          "id": "fld_sale_total_amount",
          "key": "total_amount",
          "label": "Total",
          "type": "decimal",
          "required": true,
          "precision": 14,
          "scale": 2,
          "currency": "NGN",
          "min_value": "0",
          "display_role": "money"
        },
        {
          "id": "fld_sale_amount_paid",
          "key": "amount_paid",
          "label": "Amount paid",
          "type": "decimal",
          "required": true,
          "default": "0.00",
