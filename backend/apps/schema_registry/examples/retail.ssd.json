    {
      "id": "rel_sale_product",
      "from_table": "tbl_sales",
      "from_field": "fld_sale_product",
      "to_table": "tbl_products",
      "cardinality": "many_to_one",
      "optional": false,
      "on_delete": "restrict",
      "description": "Each sale is for one product"
    }
  ],
  "source_mappings": [
